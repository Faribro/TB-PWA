{
  "name": "hhxr-tb-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:clean": "rimraf .next && next dev --turbopack",
    "build": "rimraf .next && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "clean": "rimraf .next",
    "start": "next start",
    "lint": "next lint",
    "deploy": "vercel --prod",
    "analyze": "ANALYZE=true next build",
    "test:webhook": "node scripts/test-kobo-webhook.js",
    "test:supabase": "node scripts/verify-supabase-connection.js",
    "test:sync": "node scripts/test-triple-sync.js",
    "test:e2e": "node scripts/run-test.js",
    "test:pipeline": "node scripts/verify-supabase-connection.js && node scripts/test-triple-sync.js",
    "test:stabilization": "node scripts/test-stabilization.js",
    "load:test": "bun run scripts/load-test.ts",
    "verify:deployment": "node scripts/verify-deployment.js",
    "test:realtime-sync": "node scripts/test-realtime-sync-rigorous.js",
    "test:rbac": "node scripts/test-rbac.js",
    "test:rbac-integration": "node scripts/test-rbac-integration.js",
    "test:rbac-all": "node scripts/test-rbac.js && node scripts/test-rbac-integration.js",
    "test:reconcile": "node scripts/test-register-reconcile.js",
    "test:hybrid-ocr": "node scripts/test-hybrid-ocr.js",
    "test:upload-modal": "node scripts/test-upload-modal.js",
    "test:rls": "bun run scripts/test-rls-normalization.ts",
    "seed:knowledge": "bun run scripts/seed-knowledge-articles.ts",
    "test:sheets-sync": "bun run scripts/test-sheets-sync.ts",
    "test:webhook-refactor": "bun run scripts/test-webhook-refactor.ts",
    "test:patient-sync-refactor": "bun run scripts/test-patient-sync-refactor.ts",
    "test:realtime": "bun run scripts/test-realtime.ts",
    "test:refactor": "bun run scripts/test-refactor.ts"
  },
  "dependencies": {
